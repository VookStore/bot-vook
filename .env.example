# ==========================================================
# VOOK STORE BOT — Configuracao de ambiente
# ==========================================================

# Token do bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Application ID do bot (Discord Developer Portal > General Information)
DISCORD_CLIENT_ID=

# Opcional: registra os comandos apenas nesta guild (deploy instantaneo).
# Deixe vazio para registrar os comandos globalmente (propagacao mais lenta).
DISCORD_GUILD_ID=

# String de conexao PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/vookstore?schema=public

# production | development | test
NODE_ENV=production

# error | warn | info | debug
LOG_LEVEL=info

# ----------------------------------------------------------
# Transcript hospedado (opcional)
# ----------------------------------------------------------
# As duas andam juntas: definir so uma e erro de configuracao.
# Vazias, o transcript continua indo como ANEXO no canal de logs.
# O token e o mesmo do `wrangler secret put UPLOAD_TOKEN`.
TRANSCRIPT_BASE_URL=
TRANSCRIPT_UPLOAD_TOKEN=

# ----------------------------------------------------------
# Backup do banco
# ----------------------------------------------------------
# Backup diario pelo proprio bot, com pg_dump. true (padrao) ou false.
# Na ShardCloud use false: la nao ha pg_dump, e o banco gerenciado tem backup
# proprio no painel. Ligado sem pg_dump, o job falha e alerta todo dia.
BACKUP_ENABLED=true

# Pasta dos dumps. Relativa a raiz do projeto quando nao for absoluta.
BACKUP_DIR=backups

# Quantos dumps manter (1 a 365). Os mais antigos sao apagados.
BACKUP_RETENTION=14

# Caminho do pg_dump. Vazio = procurar no PATH e na instalacao padrao do
# PostgreSQL. Preencha quando houver mais de uma versao instalada: um pg_dump
# mais antigo que o servidor recusa gerar o dump.
# Ex.: C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
PG_DUMP_PATH=

# Dias que um transcript hospedado sobrevive apos o ticket fechar.
# 0 ou vazio = NUNCA apagar (padrao). O transcript guarda a conversa inteira,
# prints e as vezes comprovante bancario; um acervo que so cresce e risco puro.
# Sugestao: 180 (seis meses). O registro do ticket no banco nunca e apagado.
TRANSCRIPT_RETENTION_DAYS=

# Canal onde os erros de fundo do bot sao publicados.
# Vazio DESLIGA o alerta (o erro continua indo para o log e para o banco).
# Fica aqui e nao na configuracao da guild porque muita falha nao tem guild
# nenhuma — backup, agendador, gateway — e essas sao as que ninguem ve.
ALERT_CHANNEL_ID=

# Canal interno onde o site envia as inscricoes de influencers/streamers.
# A equipe usa os botoes Aprovar/Reprovar publicados neste canal.
INFLUENCER_APPROVAL_CHANNEL_ID=
